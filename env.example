# Mesma connection string do Neon que já está no config.toml do app desktop.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Usuário/senha do painel admin (/admin). Gere o hash com:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'suasenha', bcrypt.gensalt()).decode())"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Segredo compartilhado só entre o servidor e o app desktop (NÃO é senha de
# usuário) — autentica a chamada automática de POST /api/register-license
# quando alguém cria conta no app. Gere qualquer string aleatória longa, ex:
#   python -c "import secrets; print(secrets.token_hex(32))"
# e coloque o MESMO valor no config.toml do app desktop, chave
# APP_SHARED_SECRET, antes de gerar o instalador.
APP_SHARED_SECRET=
